{
  "name": "wows-omp-plugin-adr",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "Tool-managed MADR architecture decision records",
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "settings": {
      "uiMenu": {
        "type": "enum",
        "values": [
          "inline",
          "fullscreen"
        ],
        "default": "fullscreen",
        "description": "How /adr shows its menu and write previews: a fullscreen console with a list and the full decision text, or the small select dialogs"
      }
    }
  }
}
